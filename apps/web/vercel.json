{
  "version": 2,
  "name": "neurolingua-web",
  "buildCommand": "cd ../.. && npm run build --filter=@neurolingua/web",
  "outputDirectory": "apps/web/.next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1", "sfo1", "lhr1", "sin1"],
  "env": {
    "NEXTAUTH_URL":            { "target": "production", "value": "https://neurolingua.ai" },
    "NODE_ENV":                { "target": "production", "value": "production" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "DENY"         },
        { "key": "X-Content-Type-Options", "value": "nosniff"      },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(), microphone=(self), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/backend/:path*", "destination": "https://api.neurolingua.ai/:path*" }
  ]
}
