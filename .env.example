# ═══════════════════════════════════════════════════
# NeuroLingua AI — Environment Variables
# Copy this file to .env.local and fill in values
# ═══════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── Database (PostgreSQL) ────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/neurolingua

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── NextAuth ──────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=http://localhost:3000

# ── OAuth — Google ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ── OAuth — GitHub ────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# ── OAuth — Apple ─────────────────────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:4000/auth/apple/callback

# ── AI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=         # future

# ── Stripe ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Redis (rate limiting + cache) ─────────────────────
REDIS_URL=redis://localhost:6379

# ── Email (Magic Link) ───────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
EMAIL_FROM=noreply@neurolingua.ai

# ── Vercel (set automatically on Vercel) ─────────────
# VERCEL_URL=
# VERCEL_ENV=
